# ============================================================================
# .env.example — скопируйте в .env и заполните. НИКОГДА не коммитьте .env.
# На agrobot-prod этот же файл живёт как /etc/tubecook.env (chmod 600).
# ============================================================================

# --- Стоки (Глава 3.2): Pexels — бесплатный ключ, 200 запросов/час, 20000/мес
# https://www.pexels.com/api/ -> Create key
PEXELS_API_KEY=

# --- Telegram HITL-бот (Глава 5.4): @BotFather -> /newbot -> токен
TUBECOOK_TOKEN=1234567890:AAA-your-bot-token
# свой chat_id: напишите боту @userinfobot и возьмите Id
TUBECOOK_ADMIN=123456789
TUBECOOK_JOBS=jobs
# команда рендера НА НОУТБУКЕ; {id} будет подставлен автоматически
TUBECOOK_RENDER_CMD=ssh hp-laptop 'cd ~/field-manual-scripts && python3 06_render_short.py --manifest jobs/{id}.json --stage all'
# где искать превью 270x480 для HITL-проверки
TUBECOOK_PREVIEW=build/{id}/out/preview_270x480.mp4

# --- YouTube Data API v3 (Глава 5.5): OAuth «Desktop app»
# console.cloud.google.com -> APIs -> YouTube Data API v3 -> Credentials
# скачайте client_secret.json рядом со скриптом 07_upload_youtube.py
# ВАЖНО: переведите OAuth consent screen в Production (Testing = токен живёт 7 дней)
GOOGLE_CLIENT_SECRET=client_secret.json
