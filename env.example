# ============================================================================
# env.example — Tubecook v4. Скопируйте в .env и заполните ЛОКАЛЬНО.
# НИКОГДА не коммитьте .env / token.json / client_secret.json.
# В этот файл значений не вписывать (проверяется тестом test_no_secrets).
# ============================================================================

# --- доступ (Telegram ID, НЕ токены; у @userinfobot узнайте свой Id) ---
TUBECOOK_ADMINS=
TUBECOOK_SENDERS=

# --- пути ---
TUBECOOK_DATA=
TUBECOOK_DB=
TUBECOOK_JOBS_DIR=
TUBECOOK_OUTBOX=
TUBECOOK_LOG=
TUBECOOK_TZ=

# --- фоновая музыка (v4.1) ---
# Категория нейтральной подложки: news (по умолчанию) | legal | tech
# или legacy (старый мрачный трек), none (без музыки) либо путь к файлу.
# Треки генерируются scripts/make_bgm.py (без внешних сервисов и лицензий).
TUBECOOK_BGM=
# Громкость подложки ДО даккинга, 0.0..1.5 (треки нормализованы к пику -12 dBFS;
# 0.5 = легкий фон, голос остаётся чистым; 0 — музыка не слышна)
TUBECOOK_BGM_VOLUME=

# --- озвучка ---
TUBECOOK_VOICE=
TUBECOOK_RATE=

# --- режимы (см. README, раздел «Режимы и безопасность») ---
TUBECOOK_REQUIRE_APPROVAL=
TUBECOOK_AUTONOMOUS=
TUBECOOK_PUBLISH_LIVE=

# --- очередь ---
TUBECOOK_LEASE_S=
TUBECOOK_MAX_ATTEMPTS=
TUBECOOK_NEWS_TTL_H=

# --- рендер ---
TUBECOOK_HW=
TUBECOOK_RENDER_PROFILE=
TUBECOOK_CRF=
TUBECOOK_TAIL_S=
TUBECOOK_FONT_BOLD=
TUBECOOK_FONT_REGULAR=
TUBECOOK_SUB_FONT=

# --- Telegram-публикация (секрет — только в .env на ноутбуке) ---
TUBECOOK_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BUDGET_MB=

# --- YouTube Shorts (OAuth локально: cli oauth-youtube) ---
YOUTUBE_CHANNEL_ID=
YOUTUBE_PRIVACY=
YOUTUBE_MADE_FOR_KIDS=
YOUTUBE_DISCLOSE_SYNTHETIC=
