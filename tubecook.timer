# ============================================================================
# tubecook.timer — ежедневный «будильник» бота (04:00 MSK) + защита от зависаний
# Перезапуск сервиса вызывает scanAndOffer(): свежая партия утром в Telegram.
[Unit]
Description=Ежедневный перезапуск tubecook (утренняя партия задач)

[Timer]
OnCalendar=*-*-* 04:00:00
# если сервер был выключен в момент срабатывания — выполнит при включении
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
